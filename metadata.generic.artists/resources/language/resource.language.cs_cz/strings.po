msgctxt "Addon Summary"
msgid "Generic music scraper for artists"
msgstr "Obecný zdroj informací o hudebních interpretech"

msgctxt "Addon Description"
msgid "Searches for artist information and artwork across multiple websites."
msgstr "Vyhledává informace o interpretech a grafiku na různých webech."

msgctxt "#30000"
msgid "Preferences"
msgstr "Předvolby"

msgctxt "#30001"
msgid "Preferred language for artist biography"
msgstr "Upřednostňovaný jazyk biografie interpreta"

msgctxt "#30002"
msgid "Prefer biography from"
msgstr "Upřednostňovat biografii z"

msgctxt "#30003"
msgid "Prefer discography from"
msgstr "Upřednostňovat diskografii z"

msgctxt "#30004"
msgid "Prefer genres from"
msgstr "Upřednostňovat žánry z"

msgctxt "#30005"
msgid "Prefer styles from"
msgstr "Upřednostňovat styly z"

msgctxt "#30006"
msgid "Prefer moods from"
msgstr "Upřednostňovat nálady z"

msgctxt "#30007"
msgid "Preferred MusicBrainz artist name locale"
msgstr "Upřednostňované jazykové a regionální nastavení jména interpreta v MusicBrainz"

msgctxt "#30008"
msgid "Custom locale"
msgstr "Vlastní jazykové a regionální nastavení"

msgctxt "#30009"
msgid "Default locale"
msgstr "Výchozí jazykové a regionální nastavení"

msgctxt "#30010"
msgid "Current Kodi locale"
msgstr "Aktuální jazykové a regionální nastavení Kodi"

msgctxt "#30011"
msgid "Custom locale"
msgstr "Vlastní jazykové a regionální nastavení"

msgctxt "#30012"
msgid "Discogs access token"
msgstr ""

msgctxt "#30101"
msgid "Allow less accurate search results"
msgstr "Povolit méně přesné výsledky vyhledávání"

msgctxt "#30201"
msgid "If available, the artist biography will be downloaded in the selected language. It will fallback to English."
msgstr "Biografie interpreta se stáhne ve vybraném jazyce, pokud je dostupná. V opačném případě se stáhne v angličtině."

msgctxt "#30202"
msgid "Try to get the artist biography using the selected scraper. Other scrapers will be used if the preferred scraper returns no results."
msgstr "Pokusí se získat biografii interpreta pomocí vybraného zdroje. Pokud upřednostňovaný zdroj nevrátí žádné výsledky, použijí se jiné zdroje."

msgctxt "#30203"
msgid "Try to get the artist discography using the selected scraper. Other scrapers will be used if the preferred scraper returns no results."
msgstr "Pokusí se získat diskografii interpreta pomocí vybraného zdroje. Pokud upřednostňovaný zdroj nevrátí žádné výsledky, použijí se jiné zdroje."

msgctxt "#30204"
msgid "Try to get genre info using the selected scraper. Other scrapers will be used if the preferred scraper returns no results."
msgstr "Pokusí se získat informace o žánrech interpreta pomocí vybraného zdroje. Pokud upřednostňovaný zdroj nevrátí žádné výsledky, použijí se jiné zdroje."

msgctxt "#30205"
msgid "Try to get style info using the selected scraper. Other scrapers will be used if the preferred scraper returns no results."
msgstr "Pokusí se získat informace o stylech interpreta pomocí vybraného zdroje. Pokud upřednostňovaný zdroj nevrátí žádné výsledky, použijí se jiné zdroje."

msgctxt "#30206"
msgid "Try to get mood info using the selected scraper. Other scrapers will be used if the preferred scraper returns no results."
msgstr "Pokusí se získat informace o náladách interpreta pomocí vybraného zdroje. Pokud upřednostňovaný zdroj nevrátí žádné výsledky, použijí se jiné zdroje."

msgctxt "#30207"
msgid "Choose whether to use the default MusicBrainz artist name, your current Kodi locale, or a custom locale for MusicBrainz artist names."
msgstr "Zvolte, zda chcete používat výchozí jméno interpreta z MusicBrainz, aktuální jazykové a regionální nastavení Kodi, nebo vlastní jazykové a regionální nastavení pro jména interpretů z MusicBrainz."

msgctxt "#30208"
msgid "Choose a custom locale, e.g. pt-PT or pt-BR, or language: pt"
msgstr "Zvolte vlastní jazykové a regionální nastavení, např. pt-PT nebo pt-BR, nebo jazyk: pt"

msgctxt "#30209"
msgid "In order to use the discogs scraper, you need to create an account at discogs.com and generate a personal access token"
msgstr ""

msgctxt "#30301"
msgid "If Musicbrainz does not provide a link to allmusic and/or discogs, we can search those sites based on artistname. Since artist names are not unique, this could potentially result in a mixture of metadata from multiple artists by the same name."
msgstr "Pokud MusicBrainz neposkytne odkaz na allmusic a/nebo Discogs, můžeme tyto weby prohledat podle jména interpreta. Protože jména interpretů nejsou jedinečná, může to vést ke smíchání metadat několika interpretů se stejným jménem."
